classDiagram
  class Passenger["Пасажир"] {
    +UUID Ідентифікатор
    +Текст Ім'я
    +Текст Телефон
    +Поїздка Замовити(подача, призначення)
  }
  class Driver["Водій"] {
    +UUID Ідентифікатор
    +Текст Ім'я
    +Логічне Доступний
    +Дія ЗмінитиДоступність(значення)
  }
  class Vehicle["Транспортний засіб"] {
    +UUID Ідентифікатор
    +Текст НомернийЗнак
    +Текст Модель
    +Ціле Місткість
  }
  class Trip["Поїздка"] {
    +UUID Ідентифікатор
    +Стан Стан
    +Число Вартість
    +ДатаЧас Створено
    +Дія Призначити(id)
    +Дія Почати()
    +Дія Завершити()
    +Дія Скасувати()
  }
  class Payment["Оплата"] {
    +UUID Ідентифікатор
    +Число Сума
    +Текст НомерСервісу
    +Стан Стан
    +Дія ПозначитиСплату(ref)
  }
  class SafetyIncident["Повідомлення про подію"] {
    +UUID Ідентифікатор
    +ДатаЧас ЧасПодії
    +Текст Опис
    +Логічне Опрацьовано
    +Дія Опрацювати()
  }
  class GeoPoint["Географічна точка"] {
    +Число Широта
    +Число Довгота
  }
  Passenger "1" --> "0..*" Trip : замовляє
  Driver "0..1" --> "0..*" Trip : приймає
  Driver "1" o-- "0..*" Vehicle : використовує
  Trip "1" *-- "2" GeoPoint : маршрут
  Trip "1" --> "0..1" Payment : має оплату
  Trip "1" --> "0..*" SafetyIncident : має повідомлення
